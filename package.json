{
  "name": "quiet-workspace",
  "private": true,
  "workspaces": [
    "packages/theme",
    "website"
  ],
  "scripts": {
    "start": "npm run start --workspace quiet-docs -- --port 4210 --host 127.0.0.1",
    "build": "npm run build --workspace quiet-docs",
    "test": "node --test tests/*.test.cjs",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "pack:theme": "mkdir -p .artifacts && npm pack --workspace docusaurus-theme-quiet --pack-destination .artifacts",
    "preview:biel": "node scripts/preview-consumer.cjs biel",
    "preview:pushfeedback": "node scripts/preview-consumer.cjs pushfeedback",
    "check:package": "node scripts/check-package.cjs",
    "check:site": "node scripts/check-site.cjs",
    "release:check": "npm test && npm run lint && npm run build && npm run check:site && npm run check:package && npm run pack:theme"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "tinypool": "2.1.2",
    "serialize-javascript": "7.1.3"
  },
  "overrides": {
    "tinypool": "$tinypool",
    "serialize-javascript": "$serialize-javascript"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
